{
  "branches": ["main"],
  "tagFormat": "v${version}",
  "plugins": [
    ["@semantic-release/commit-analyzer", { "preset": "conventionalcommits" }],
    ["@semantic-release/release-notes-generator", { "preset": "conventionalcommits" }],
    ["@semantic-release/exec", {
      "prepareCmd": "npm pkg set version=${nextRelease.version} && npm run dist:win"
    }],
    ["@semantic-release/github", {
      "assets": [
        { "path": "dist/IlVoloDelDrago-*.exe", "label": "Il Volo del Drago ${nextRelease.version} (Windows x64)" }
      ],
      "successComment": false,
      "failComment": false,
      "releasedLabels": false
    }]
  ]
}
